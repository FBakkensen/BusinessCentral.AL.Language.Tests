enum 60009 "ALT Status"
{
    Extensible = false;

    value(0; " ")
    {
        Caption = ' ';
    }
    value(1; Draft)
    {
        Caption = 'Draft';
    }
    value(2; Active)
    {
        Caption = 'Active';
    }
    value(3; Closed)
    {
        Caption = 'Closed';
    }
    value(4; Archived)
    {
        Caption = 'Archived';
    }
}
